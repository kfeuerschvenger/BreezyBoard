PORT=5000
# The board delete cascade runs in a transaction, and transactions require a
# replica set. A standalone mongod will refuse them. Either run the stack with
# docker compose, which provisions a single node set called rs0, or start a
# local mongod with --replSet rs0 and initiate it once from mongosh with
# rs.initiate().
MONGODB_URI=mongodb://localhost:27017/boards-db?replicaSet=rs0
JWT_SECRET=4vr4k3hd4br4
NODE_ENV=development
DOTENV_CONFIG_QUIET=true
# Password reset mail. Development defaults point at a local Mailpit
# (docker compose starts one, web interface on http://localhost:8025).
# In production FRONTEND_URL, SMTP_HOST and MAIL_FROM are required, and
# SMTP_USER and SMTP_PASSWORD must be set together or not at all.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=BreezyBoard <no-reply@breezyboard.local>
