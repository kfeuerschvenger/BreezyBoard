# BreezyBoard architecture, dark variant: the light diagram with dark tones of the same six hues.
...@architecture

style.fill: "#0d1117"

classes.sky.style: {fill: "#08384c"; stroke: "#46b1e3"; font-color: "#cbeeff"}
classes.teal.style: {fill: "#003c3b"; stroke: "#10b9b5"; font-color: "#bef4f1"}
classes.green.style: {fill: "#193b22"; stroke: "#66b679"; font-color: "#cff3d5"}
classes.sand.style: {fill: "#422f07"; stroke: "#c7993e"; font-color: "#fbe5bf"}
classes.coral.style: {fill: "#4d271b"; stroke: "#e18669"; font-color: "#ffdcce"}
classes.lavender.style: {fill: "#382b4d"; stroke: "#ad90e1"; font-color: "#ede0ff"}
classes.group-sky.style: {fill: "#0f1b2d"; stroke: "#46b1e3"; font-color: "#a9e0fe"}
classes.group-teal.style: {fill: "#0c1f22"; stroke: "#10b9b5"; font-color: "#a1e7e3"}
classes.group-sand.style: {fill: "#1f1a10"; stroke: "#c7993e"; font-color: "#efd4a3"}
classes.flow.style: {stroke: "#7fd0f5"; font-color: "#a9e0fe"}
