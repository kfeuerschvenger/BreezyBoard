# Toggles React StrictMode in development. Leave false unless you are chasing
# an effect that misbehaves under double invocation.
VITE_USE_STRICT_MODE=false

# Base URL of the API. Vite inlines every VITE_ variable into the built bundle
# at build time, so this is baked in and cannot be changed after the build.
# In the production compose file nginx proxies /api, so the value there is
# /api/v1. /api still works as a deprecated alias, but /api/v1 is the
# versioned path clients should actually exercise.
VITE_API_URL="http://localhost:5000/api/v1"

# Never put a secret in this file. Anything prefixed VITE_ is inlined into the
# bundle and readable by anyone who opens devtools. A VITE_JWT holding the
# backend signing secret used to live here; it had no consumers, and it was
# removed before one appeared.
